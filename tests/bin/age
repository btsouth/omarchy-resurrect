#!/bin/bash
# Test double: a reversible stand-in for age. It is NOT encryption — it base64
# encodes behind a magic header so the secrets path can be exercised without a
# real key. Only ever runs inside the test sandbox.
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"
log_call "age $*"

MAGIC="AGE-FAKE-NOT-ENCRYPTION"
mode=encrypt out="" 
while (( $# > 0 )); do
  case "$1" in
    -d|--decrypt) mode=decrypt; shift ;;
    -o) out="${2:-}"; shift 2 ;;
    -p|--passphrase) shift ;;
    -i|-r|-R) shift 2 ;;
    *) input="$1"; shift ;;
  esac
done

if [[ $mode == encrypt ]]; then
  { printf '%s\n' "$MAGIC"; base64; } >"${out:-/dev/stdout}"
  exit 0
fi

src="${input:-/dev/stdin}"
head -1 "$src" | grep -qxF "$MAGIC" || { echo "age: no identity matched" >&2; exit 1; }
tail -n +2 "$src" | base64 -d
exit 0
