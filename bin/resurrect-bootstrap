#!/bin/bash
#
# The one command you run on a machine that has nothing on it yet.
#
#   curl -fsSL https://raw.githubusercontent.com/tsouth89/omarchy-resurrect/main/bin/resurrect-bootstrap \
#     | bash -s -- https://github.com/you/my-omarchy-vault
#
# It installs Resurrect, then replays your vault. Nothing else is assumed to be
# on the machine except Omarchy itself and git.

set -euo pipefail

PLUGIN_ID="tsouth89.resurrect"
PLUGIN_REPO="${RESURRECT_REPO:-https://github.com/tsouth89/omarchy-resurrect.git}"
PLUGIN_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"

VAULT_URL="${1:-}"
if [[ -z $VAULT_URL ]]; then
  cat >&2 <<USAGE
Usage: resurrect-bootstrap <vault-git-url>

  <vault-git-url>  the repo `ress backup` pushes to.

Pass a loadout instead of a vault to install someone else's setup:
  resurrect-bootstrap --loadout <profile-git-url>
USAGE
  exit 1
fi

command -v git >/dev/null || { echo "bootstrap: git is required" >&2; exit 1; }

echo "▸ Installing Resurrect"
if [[ -d $PLUGIN_DIR/.git ]]; then
  git -C "$PLUGIN_DIR" pull -q --ff-only || true
else
  mkdir -p "$(dirname "$PLUGIN_DIR")"
  git clone -q --depth 1 "$PLUGIN_REPO" "$PLUGIN_DIR"
fi

# Let the shell pick the plugin up if one happens to be running. On a machine
# still at a TTY this simply does nothing, and the restore works anyway.
command -v omarchy-shell >/dev/null && omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true

if [[ $VAULT_URL == "--loadout" ]]; then
  exec "$PLUGIN_DIR/bin/ress" apply "${2:?loadout url required}"
fi

echo "▸ Restoring from $VAULT_URL"
exec "$PLUGIN_DIR/bin/ress" restore --from "$VAULT_URL"
